// Deepslate Works · see docs/03-data-model.md
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PLAYER
}

enum PcTier {
  LOW
  MID
  HIGH
}

// docs/16 §1: everything the portal has seen or done, in one log.
enum EventKind {
  JOIN
  LEAVE
  DEATH
  CHAT
  ADVANCEMENT
  SERVER_START
  SERVER_STOP
  CRASH
  WARN
  ERROR
  ADMIN_ACTION
  PLAYER_ACTION
  LINK
  REVOKE
  SYNC
  BACKUP
  INSTALL
  JOIN_BLOCKED
  DOWNLOAD
}

enum VoteStatus {
  DRAFT
  OPEN
  CLOSED
}

model User {
  id           String    @id @default(cuid())
  displayName  String
  role         Role      @default(PLAYER)
  discordId    String?   @unique
  email        String?   @unique // credentials fallback only
  passwordHash String?   // credentials fallback only
  mcUsername   String?   @unique // Minecraft Java username, set by the player
  mcUuid       String?   @unique // resolved from the Mojang API
  pcTier       PcTier?
  pcTierSource String    @default("self") // "self": what they picked; "measured": worked out from the installer's report of their PC
  pcTierWhy    String?   // what it was worked out from, e.g. "32 GB of memory, NVIDIA GeForce RTX 3070"
  pcTierAt     DateTime? // when it was last measured
  verifiedAt   DateTime? // when the in-game link (docs/14) or an admin verified the Minecraft account
  guildMember  Boolean   @default(true) // cache of the last Discord server membership check
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime?
  invitedById  String?
  ballots      Ballot[]
  launcherAuth LauncherAuth[]
  installs     InstallReport[]
  earlyAccess  Boolean  @default(false) // docs/13: uses the portal as if it were live while it is not
  sessionVersion Int    @default(0) // raised to end every session the member has (made a player, password sign-in turned off)
  adminLogin   AdminLogin?
  oneTimeLogins OneTimeLogin[]
  pollAnswers  PollAnswer[]
}

/// Admin password sign-in (planner, 2026-10-01): username + password (argon2id) + authenticator code. Admins only.
model AdminLogin {
  userId        String    @id
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  username      String    @unique // lower case
  passwordHash  String    // argon2id
  totpSecret    String?   // encrypted with a key from AUTH_SECRET; null after a break-glass reset
  pendingSecret String?   // a new authenticator being set up, not confirmed yet (encrypted)
  enabled       Boolean   @default(false) // only once an authenticator code has been confirmed
  lastStep      Int?      // the 30-second step of the last code accepted: a code works once
  recovery      Json      @default("[]") // [{ h: HMAC of the code, usedAt: ISO | null }], 10 at a time
  createdAt     DateTime  @default(now())
  enabledAt     DateTime?
  passwordAt    DateTime  @default(now())
}

/// Break-glass (docs/09): a one-time sign-in link made by the CLI in the api container. Valid 15 minutes, once.
model OneTimeLogin {
  tokenHash String    @id // sha256 of the token in the link
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Invite {
  code      String   @id // 8 chars, human-readable
  createdBy String
  usedBy    String?  @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  note      String?
}

model Vote {
  id         String     @id @default(cuid())
  title      String
  status     VoteStatus @default(DRAFT)
  opensAt    DateTime?
  closesAt   DateTime?
  questions  Json
  resultJson Json?
  mustVote   Boolean    @default(false) // planner 2026-10-02: members answer it before they can play (the door holds them)
  ballots    Ballot[]
}

/// A quick single question (planner 2026-10-02, "votes before play"): 2 to 8 options plus "I don't mind", single or
/// multiple choice, optionally closing by itself. Separate from the season's mod ballot (Vote).
model Poll {
  id        String     @id @default(cuid())
  question  String
  options   Json       // [{id, text, image?, link?, modId?}], "I don't mind" last (shared/polls.ts)
  multiple  Boolean    @default(false)
  mustVote  Boolean    @default(true)
  status    VoteStatus @default(OPEN)
  createdAt DateTime   @default(now())
  createdBy String
  openedAt  DateTime?
  closesAt  DateTime?
  closedAt  DateTime?
  closedBy  String?    // a member's id, or "system" when it closed at its date
  answers   PollAnswer[]

  @@index([status, openedAt])
}

/// One member's answer to a poll; changed in place until the poll closes.
model PollAnswer {
  id        String   @id @default(cuid())
  pollId    String
  userId    String
  choices   String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([userId])
}

model Ballot {
  id          String   @id @default(cuid())
  voteId      String
  userId      String
  modIds      String[]
  answers     Json
  submittedAt DateTime @updatedAt
  vote        Vote     @relation(fields: [voteId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([voteId, userId])
}

// docs/14: one-time code shown in game to an unlinked player; binds their UUID to the portal account.
model LinkCode {
  code       String   @id // 8 chars, unambiguous alphabet
  mcUuid     String
  mcUsername String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  usedById   String?

  @@index([mcUuid])
}

// One row ("site"): the launch switch. Until `live`, players see a launch page, no address, no downloads.
model SiteSettings {
  id          String    @id @default("site")
  live        Boolean   @default(false)
  launchAt    DateTime?
  updatedAt   DateTime  @updatedAt
  updatedById String?
}

// Installer / updater sign-in ("device" flow): the script shows a code, the user approves it in the browser
// after a Discord login, the script polls with pollToken and receives a launcher token (stored hashed).
model LauncherAuth {
  code            String    @id // 8 chars shown in the script and on the approval page
  pollToken       String    @unique
  tokenHash       String?   @unique // sha256 of the launcher token handed to the script
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String    @default("pending") // pending | approved | denied | expired
  hostname        String?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime  // approval window (10 min) then, once approved, token lifetime (7 days)
  approvedAt      DateTime?
  lastUsedAt      DateTime?
}

model Announcement {
  id        String   @id @default(cuid())
  image       String?   // a picture's file name under data/news (docs/05)
  body        String
  pinned      Boolean   @default(false)
  pinnedUntil DateTime? // pinned only until then; null = until unpinned (docs/05)
  expiresAt   DateTime? // not shown to members from then on; null = always (docs/05)
  createdAt DateTime @default(now())
  authorId  String
}

// One row per player session on the Minecraft server (docs/16 §1).
model Session {
  id       String    @id @default(cuid())
  mcUuid   String    // "name:<lowercase name>" until the UUID is known
  mcName   String    // the name they played under
  userId   String?   // linked portal user, if any
  joinedAt DateTime
  leftAt   DateTime? // null while online; closed on leave, server stop, or the poller seeing them gone
  ip       String?   // from the join line; admin-only, pruned after 30 days
  country  String?   // ISO code, resolved once from ip with a local database (no external calls)

  @@index([mcUuid, joinedAt])
  @@index([joinedAt])
  @@index([leftAt])
}

// The event log (docs/16 §4). Replaces AuditLog: portal actions are ADMIN_ACTION / PLAYER_ACTION rows,
// with the action name, parameters and result in `meta`.
model Event {
  id      BigInt    @id @default(autoincrement())
  at      DateTime  @default(now())
  kind    EventKind
  actor   String?   // mcUuid (game events) or userId (portal actions)
  message String    // human line
  raw     String?   // original console line, admin-only
  meta    Json?
  count   Int       @default(1) // WARN / ERROR repeated within 60 s are one row with a count

  @@index([at])
  @@index([kind, at])
  @@index([actor, at])
}

// What the Windows installer sends at the end of every run (docs/07 "Install reports"). The log and the
// system description are redacted on the PC before they are sent and again here before they are stored:
// no Windows user name, no paths under C:\Users\<name>, no tokens, no addresses. Kept for 90 days.
model InstallReport {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  at               DateTime @default(now())
  packVersion      String
  installerVersion String
  mode             String   @default("install") // install | play | first_install | update | already_running | uninstall (lib/install-report.ts MODES)
  updatedFrom      String?  // the installer version that fetched this one and started it (docs/07 "The installer updates itself")
  updateProblem    String?  // why an update that was due was not applied, e.g. the checksum did not match
  outcome          String   // ok | failed | cancelled | skipped
  failedStep       String?
  durationSec      Int
  system           Json
  log              String
  tierBefore       String?  // the member's PC tier when the report arrived
  tierMeasured     String?  // the tier worked out from this report's hardware
  setupProblems    Json?    // 1.5.6: [{part, code, message}] what could not be set up on the PC; null when the installer does not say
  playLinkMissing  Boolean? // 1.5.6: the Play button has no working link on that PC after this run (lib/install-report.ts)

  minimal         Boolean  @default(false) // 2.0.0: reports declined in the app: "pressed Play, pack version" only, no log, no PC details
  extras          Json?    // 2.0.1: the Extras tab on that PC: switched on, last Apply, checks, in game (lib/extras-line.ts)
  mods            Json?    // 2.1.0: the pack's mods on that PC before the game started, or in the game it started (lib/install-report.ts modsSchema)

  @@index([at])
  @@index([userId, at])
}

// Key/value settings edited from the admin pages (docs/16 §5, §6): "branding", "privacy", "retention", "files".
model Setting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model ServerSnapshot {
  id      Int      @id @default(autoincrement())
  at      DateTime @default(now())
  state   String
  players String[]
  tps     Float?
  cpu     Float?
  memMb   Int?
  pings   Json?    // {"<uuid>": milliseconds} for whoever was on and had been measured (docs/05 "Connection")

  @@index([at])
}

// docs/21: Discord messages that are edited after they are posted (a vote's count and result, a run of deaths).
// Only keyed messages get a row; plain lines are posted and forgotten.
model DiscordPost {
  id        String    @id @default(cuid())
  key       String    @unique // "poll:<id>", "ballot:<id>", "deaths:<uuid>", "remind:poll:<id>", "welcome:<userId>"
  channel   String    // "feed" | "admin"
  messageId String    // Discord's id of the message; "" for a marker (something decided, nothing posted)
  postedAt  DateTime  @default(now())
  editedAt  DateTime?
}
