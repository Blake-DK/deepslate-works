# Copy to deploy/.env (git-ignored). Every variable, with a comment and a placeholder value.
# Placeholders: "replace-me-..." for secrets, all zeros for Discord and AMP ids, *.dsw.test for domains,
# 10.77.0.x and 100.64.0.x for addresses. deploy/deploy.sh stops while any replace-me or all-zero id is
# left: fill it in, or leave an optional one empty (the comment says which are optional).

# Absolute path of this checkout on the host. Dockhand runs the stack from its own directory, so host paths
# in docker-compose.yml are built from this. Leave empty only for a local run from deploy/.
DEEPSLATE_DIR=/home/ladm/Minecraft-site

# GitHub owner (lower case) of the GHCR images ghcr.io/<owner>/deepslate-web and deepslate-api.
GHCR_OWNER=replace-me-github-owner
# Image tag for Dockhand's copy of the stack only. deploy/deploy.sh does not read it: it deploys the images of the
# commit the checkout is at (docs/31 B-08); pin or roll back with `sudo IMAGE_TAG=<sha> deploy/deploy.sh`.
IMAGE_TAG=latest

# Postgres password; DATABASE_URL is derived from it in docker-compose.yml.
POSTGRES_PASSWORD=replace-me-long-random-password

# Auth.js. AUTH_SECRET: openssl rand -base64 32
# It also seals the admins' authenticator secrets (docs/04): a new one ends every session AND every admin's
# authenticator (each sets password sign-in up again).
AUTH_SECRET=replace-me-openssl-rand-base64-32
AUTH_URL=https://deepslate.dsw.test
# Parent-domain cookie so map.deepslate.dsw.test shares the login and nothing else on dsw.test sees it.
COOKIE_DOMAIN=.deepslate.dsw.test

# Discord OAuth app (https://discord.com/developers/applications). Redirect URL: <AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=replace-me-discord-client-secret
# The first login from this Discord user id becomes ADMIN without an invite.
ADMIN_DISCORD_ID=000000000000000000
# Optional: only members of this Discord server may sign in with Discord (adds the `guilds` OAuth scope).
# Server Settings → Widget → Server ID, or enable Developer Mode and right-click the server → Copy ID.
DISCORD_GUILD_ID=000000000000000000
# 1 = being in that server counts as the invite (no invite link needed for Discord users). 0 = still need an invite.
DISCORD_GUILD_AUTO_JOIN=0
# The bot of the Discord app above (Developer Portal → Bot → Reset Token). With it: vote buttons, chat relay,
# slash commands, and leaving the Discord server is noticed within seconds (docs/22). Empty = none of that.
# api also reads DISCORD_CLIENT_ID (the app's id, above) and DISCORD_GUILD_ID for it.
DISCORD_BOT_TOKEN=replace-me-discord-bot-token
# Discord feed (docs/21, docs/22 §13): the webhook of the text channel #game-chat (chat and the everyday lines).
# Empty = no feed.
DISCORD_WEBHOOK_FEED=https://discord.com/api/webhooks/000000000000000000/replace-me
# Optional: a webhook of a private channel for crashes and problems.
DISCORD_WEBHOOK_ADMIN=https://discord.com/api/webhooks/000000000000000000/replace-me
# A webhook of the forum channel season-updates: votes and season posts go through it (docs/22 §13).
DISCORD_WEBHOOK_UPDATES=https://discord.com/api/webhooks/000000000000000000/replace-me

# web -> api (docs/13). api is deepslate-wg:4000 on the internal network; token: openssl rand -hex 32
API_URL=http://deepslate-wg:4000
API_SERVICE_TOKEN=replace-me-openssl-rand-hex-32

# AMP on the homelab, reached only by `api` through the WireGuard tunnel. Talk to the ADS; the
# instance is addressed by id through the ADS proxy path (docs/13 §4). pangolin is never used.
AMP_URL=http://10.77.0.2:8080
AMP_INSTANCE_ID=00000000-0000-0000-0000-000000000000
AMP_USERNAME=webapp
AMP_PASSWORD=replace-me-amp-password
AMP_TUNNEL_IP=10.77.0.2
RSYNC_TARGET=amp@10.77.0.2:
# 1 = run without a real AMP (until the instance exists).
AMP_MOCK=1

# Shown on the home and install pages.
# The address players join by, routed by mc-router on the homelab (docs/17):
SERVER_ADDRESS=mc.dsw.test
# Dockhand on the VPS's tailnet address (deploy/dockhand-sync.py mirrors the stack into it after every deploy).
DOCKHAND_URL=http://100.64.0.10:3690
# BlueMap host (phase 3).
MAP_URL=https://map.deepslate.dsw.test

# Modrinth requires a User-Agent that identifies the project (phase 2).
MODRINTH_USER_AGENT=deepslate-works/0.1 (name@example.com)

# For admins' own tools only (curl the mod list without a sign-in). Never stamped into an installer or shipped to a PC: openssl rand -hex 24
MANIFEST_KEY=replace-me-openssl-rand-hex-24

# docs/14 (phase 4): the sealed "white room" for unlinked players and the release point. "x y z" in the Overworld.
# docs/14: where someone who waits stands, "<dimension> x y z"; where someone who is let in stands, in the overworld
LIMBO_POS=deepslate:limbo 0.5 65 0.5
SPAWN_POS=0.5 105 0.5
