# Copy to deploy/.env (git-ignored). Every variable, with a comment.

# Postgres password; DATABASE_URL is derived from it in docker-compose.yml.
POSTGRES_PASSWORD=

# Auth.js. AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://deepslate.dsw.test
# Parent-domain cookie so the map host shares the login. Leave empty for a host-only cookie (phase 0..2).
COOKIE_DOMAIN=

# Discord OAuth app (https://discord.com/developers/applications). Redirect URL: <AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The first login from this Discord user id becomes ADMIN without an invite.
ADMIN_DISCORD_ID=

# AMP over Tailscale: the Minecraft *instance's* own API port, not the ADS port. e.g. http://100.x.y.z:8081
# (pangolin-01v is only the players' tunnel to the game port; the site never talks to it.)
AMP_URL=
AMP_USERNAME=webapp
AMP_PASSWORD=
# Set to 1 to run without a real AMP (dev).
AMP_MOCK=0

# Shown on the home and install pages.
SERVER_ADDRESS=play.dsw.test
# BlueMap host (phase 3).
MAP_URL=https://map.deepslate.dsw.test

# Modrinth requires a User-Agent that identifies the project (phase 2).
MODRINTH_USER_AGENT=deepslate-works/0.1 (alex@example.com)
