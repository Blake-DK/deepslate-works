# Copy to deploy/.env (git-ignored). Every variable, with a comment and a placeholder value.
# Placeholders: "replace-me-..." for secrets, all zeros for Discord and AMP ids, *.dsw.test for domains,
# 10.77.0.x and 100.64.0.x for addresses. deploy/deploy.sh stops while any replace-me or all-zero id is
# left: fill it in, or leave an optional one empty (the comment says which are optional).

# Absolute path of this checkout on the host. Dockhand runs the stack from its own directory, so host paths
# in docker-compose.yml are built from this. Leave empty only for a local run from deploy/.
DEEPSLATE_DIR=/home/ladm/Minecraft-site

# GitHub owner (lower case) of the GHCR images ghcr.io/<owner>/deepslate-web and deepslate-api.
GHCR_OWNER=replace-me-github-owner
# Image tag for Dockhand's copy of the stack only. deploy/deploy.sh does not read it: it deploys the images of the
# commit the checkout is at (docs/31 B-08); pin or roll back with `sudo IMAGE_TAG=<sha> deploy/deploy.sh`.
IMAGE_TAG=latest

# Postgres password; DATABASE_URL is derived from it in docker-compose.yml.
POSTGRES_PASSWORD=replace-me-long-random-password

# Auth.js. AUTH_SECRET: openssl rand -base64 32
# A new one ends every session. Without TOTP_SEAL_KEY it also seals the admins' authenticator secrets (docs/04),
# and then a new one ends every admin's authenticator too (each sets password sign-in up again).
AUTH_SECRET=replace-me-openssl-rand-base64-32
# Optional, recommended: the key that seals the admins' authenticator secrets instead (openssl rand -base64 32).
# An authenticator sealed the old way is sealed again with it at its admin's next good code. Once every admin has
# signed in once with it set, AUTH_SECRET can be rotated without resetting authenticators (docs/09).
# Keep it: losing it resets every authenticator.
TOTP_SEAL_KEY=
AUTH_URL=https://deepslate.dsw.test
# Parent-domain cookie so map.deepslate.dsw.test shares the login and nothing else on dsw.test sees it.
COOKIE_DOMAIN=.deepslate.dsw.test

# Discord OAuth app (https://discord.com/developers/applications). Redirect URL: <AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=replace-me-discord-client-secret
# The first login from this Discord user id becomes ADMIN without an invite.
ADMIN_DISCORD_ID=000000000000000000
# Optional: only members of this Discord server may sign in with Discord (adds the `guilds` OAuth scope).
# Server Settings → Widget → Server ID, or enable Developer Mode and right-click the server → Copy ID.
DISCORD_GUILD_ID=000000000000000000
# 1 = being in that server counts as the invite (no invite link needed for Discord users). 0 = still need an invite.
DISCORD_GUILD_AUTO_JOIN=0
# The bot of the Discord app above (Developer Portal → Bot → Reset Token). With it: vote buttons, chat relay,
# slash commands, and leaving the Discord server is noticed within seconds (docs/22). Empty = none of that.
# api also reads DISCORD_CLIENT_ID (the app's id, above) and DISCORD_GUILD_ID for it.
DISCORD_BOT_TOKEN=replace-me-discord-bot-token
# Discord feed (docs/21, docs/22 §13): the webhook of the text channel #game-chat (chat and the everyday lines).
# Empty = no feed.
DISCORD_WEBHOOK_FEED=https://discord.com/api/webhooks/000000000000000000/replace-me
# Optional: a webhook of a private channel for crashes and problems.
DISCORD_WEBHOOK_ADMIN=https://discord.com/api/webhooks/000000000000000000/replace-me
# A webhook of the forum channel season-updates: votes and season posts go through it (docs/22 §13).
DISCORD_WEBHOOK_UPDATES=https://discord.com/api/webhooks/000000000000000000/replace-me
# The Discord role given to everyone who has linked their game (planner, 2026-10-09), so they can be mentioned at
# once. The role's id: Discord, Server Settings, Roles, right-click the role, Copy Role ID. The bot's role must sit
# above it and the bot needs Manage Roles. Empty: off, nothing changes. Only the live api reads it.
DISCORD_PLAYER_ROLE_ID=

# web -> api (docs/13). api is deepslate-wg:4000 on the internal network; token: openssl rand -hex 32
API_URL=http://deepslate-wg:4000
API_SERVICE_TOKEN=replace-me-openssl-rand-hex-32

# AMP on the homelab, reached only by `api` through the WireGuard tunnel. Talk to the ADS; the
# instance is addressed by id through the ADS proxy path (docs/13 §4). pangolin is never used.
AMP_URL=http://10.77.0.2:8080
AMP_INSTANCE_ID=00000000-0000-0000-0000-000000000000
AMP_USERNAME=webapp
AMP_PASSWORD=replace-me-amp-password
AMP_TUNNEL_IP=10.77.0.2
RSYNC_TARGET=amp@10.77.0.2:
# The mc-router dashboard on the AMP host (Admin → Server → Router; docs/02). Read by api only, over the tunnel.
ROUTER_DASH_URL=http://10.77.0.2:8090
# 1 = run without a real AMP (until the instance exists).
AMP_MOCK=1

# Shown on the home and install pages.
# The address players join by, routed by mc-router on the homelab (docs/17). api reads it too: Admin → Server → Router never removes its route.
SERVER_ADDRESS=mc.dsw.test
# Dockhand on the VPS's tailnet address (deploy/dockhand-sync.py mirrors the stack into it after every deploy).
DOCKHAND_URL=http://100.64.0.10:3690
# BlueMap host (phase 3).
MAP_URL=https://map.deepslate.dsw.test

# Modrinth requires a User-Agent that identifies the project (phase 2).
MODRINTH_USER_AGENT=deepslate-works/0.1 (name@example.com)

# For admins' own tools only (curl the mod list without a sign-in). Never stamped into an installer or shipped to a PC: openssl rand -hex 24
MANIFEST_KEY=replace-me-openssl-rand-hex-24

# docs/14 (phase 4): the sealed "white room" for unlinked players and the release point. "x y z" in the Overworld.
# docs/14: where someone who waits stands, "<dimension> x y z"; where someone who is let in stands, in the overworld
LIMBO_POS=deepslate:limbo 0.5 65 0.5
SPAWN_POS=0.5 105 0.5

# docs/39: the build designer (Admin → Seasons → Builds, "Design a build"). Leave DESIGNER_CMD empty to switch it off:
# deploy.sh then neither starts nor keeps the `designer` container, and the card says "Not set up". On the plan's
# login only the owner (ADMIN_DISCORD_ID) may use it. Every path is the designer's own host user's (docs/39 Step 1).
DESIGNER_CMD=
DESIGNER_MODEL=replace-me-model-name
DESIGNER_TOKEN=replace-me-openssl-rand-hex-32
DESIGNER_URL=http://deepslate-designer:4100
DESIGNER_UID=1010
DESIGNER_GID=1010
DESIGNER_HOME=/home/replace-me
DESIGNER_BIN_DIR=/home/replace-me/.local/bin
DESIGNER_VERSIONS_DIR=/home/replace-me/.local/share/replace-me
DESIGNER_CREDENTIALS=/home/replace-me/.replace-me/.credentials.json
# designer calls a day, all admins together (and at most 30 an hour); they count against the plan Alex's sessions use
DESIGNER_DAILY=80

# docs/42: the test server, a hidden copy of the site (web-test, api-test) for the AMP instance DeepslateTest01.
# Off unless TEST_STACK=1: deploy.sh then neither checks these lines nor starts the two, and removes them if they run.
# With it on, deploy.sh and deploy/test-up.sh check every line below first. Its images come from the workflow
# test-images (run by hand, for dev); pull them and start the pair with `sudo deploy/test-up.sh`.
TEST_STACK=0
# The test checkout, on dev, owned by ladm (deploy/test-pull.sh keeps it at origin/dev).
TEST_DIR=/home/ladm/Minecraft-site-test
# The tag of the test images: `test` (the latest run of test-images) or a commit it built.
TEST_IMAGE_TAG=test
# The test site's address. It must sit under COOKIE_DOMAIN: Caddy lets a request through only with a live admin session.
# The Discord app above needs a second redirect address: <TEST_AUTH_URL>/api/auth/callback/discord
TEST_AUTH_URL=https://test.deepslate.dsw.test
# The test site's own session secret, never the live one: openssl rand -base64 32
TEST_AUTH_SECRET=replace-me-openssl-rand-base64-32
# web-test -> api-test (deepslate-wg:4001): openssl rand -hex 32
TEST_API_SERVICE_TOKEN=replace-me-openssl-rand-hex-32
# The live site's token for api-test's GET /test/summary (the Control Room card), which opens nothing else: openssl rand -hex 32
TEST_SUMMARY_TOKEN=replace-me-openssl-rand-hex-32
# docs/45: the live site's token for the test api's /test/app/* (the launcher's Test section, admins only). Never in the
# app, opens nothing else. Empty: the section says the test server is switched off. openssl rand -hex 32
TEST_APP_TOKEN=
# The test instance in AMP (same ADS as AMP_URL above) and the AMP user the test api signs in as.
TEST_AMP_INSTANCE_ID=00000000-0000-0000-0000-000000000000
TEST_AMP_USERNAME=webapp
TEST_AMP_PASSWORD=replace-me-amp-password
# 1 = run the test pair without a real AMP (to try the site before the instance exists).
TEST_AMP_MOCK=
# The test key's rrsync line on the AMP host (docs/42a). The key itself: deploy/keys-test/deploy.key (git-ignored, uid 1000).
TEST_RSYNC_TARGET=amp@10.77.0.2:
# The test server's game address, one more route on mc-router. Not one that says "test" or "season".
TEST_SERVER_ADDRESS=lab.dsw.test
# docs/42a: the test server is silent on Discord. These are only for a private channel nobody but admins can see, by
# webhook; empty = nothing posted (the default). Never the players' channels: deploy.sh refuses a live webhook here.
TEST_DISCORD_WEBHOOK_FEED=
TEST_DISCORD_WEBHOOK_ADMIN=
TEST_DISCORD_WEBHOOK_UPDATES=
# docs/42 T5: the seasons a test Build makes datapacks of, in place of index.json's ship (s1, or s1,sample). Empty = ship.
TEST_SEASONS_SHIP=
