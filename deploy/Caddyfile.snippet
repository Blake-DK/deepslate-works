# Blocks in /home/ladm/docker/web-proxy/etc/Caddyfile on vps-01v (edit as ladm; reload recipe in deploy/README.md).
# The test site's block (the last) goes in only when the test server is set up (docs/42).

deepslate.dsw.test {
	import common
	# No request body above 50 MB (Alex, 2026-10-07): room above the biggest server action (26 MB of poll pictures,
	# next.config.ts). The routes that read JSON hold their own, smaller limit (apps/web/src/server/read-json.ts).
	request_body {
		max_size 50MB
	}
	header X-Frame-Options SAMEORIGIN
	reverse_proxy deepslate-web:3000
}

# Live map (BlueMap on the AMP host, via the WireGuard tunnel relays). Login enforced by the portal.
map.deepslate.dsw.test {
	import common
	# the same body limit as the site's block; the map only ever reads
	request_body {
		max_size 50MB
	}
	# Only the portal may show the map inside its own pages (Alex, 2026-09-29).
	header {
		Content-Security-Policy "frame-ancestors https://deepslate.dsw.test"
		defer
	}
	# forward_auth returns the 401 as-is, so spell it out: 2xx from /api/auth/verify -> map, 401 -> portal login.
	reverse_proxy deepslate-web:3000 {
		method GET
		rewrite /api/auth/verify
		header_up X-Forwarded-Method {method}
		header_up X-Forwarded-Uri {uri}
		@good status 2xx
		handle_response @good {
			reverse_proxy deepslate-map-relay-outer:8100
		}
		@unauth status 401
		handle_response @unauth {
			redir https://deepslate.dsw.test/login?next=https://map.deepslate.dsw.test{http.request.orig_uri}
		}
	}
}

# docs/42: the test server's site (web-test). Admins only: Caddy asks the live site who this is, as for the map, and only
# a live admin's request reaches web-test. A member gets "Admins only", a stranger the live login; nobody else sees even
# the test site's own sign-in page behind it. The live session cookie stays with the live site.
test.deepslate.dsw.test {
	import common
	# the same body limit as the site's block
	request_body {
		max_size 50MB
	}
	header {
		X-Frame-Options SAMEORIGIN
		X-Robots-Tag "noindex, nofollow"
	}
	reverse_proxy deepslate-web:3000 {
		method GET
		rewrite /api/auth/verify/admin
		header_up X-Forwarded-Method {method}
		header_up X-Forwarded-Uri {uri}
		@good status 2xx
		handle_response @good {
			# who did what on the test site: every request in the access log carries the live admin's user id
			vars test_user {rp.header.X-User}
			log_append user {vars.test_user}
			reverse_proxy deepslate-web-test:3000 {
				# the live session cookie (and its chunks .0, .1) never reaches web-test, which has a cookie of its own
				header_up Cookie `(^|;\s*)__Secure-authjs\.session-token(\.\d+)?=[^;]*` ""
			}
		}
		@unauth status 401
		handle_response @unauth {
			redir https://deepslate.dsw.test/login?next=https://test.deepslate.dsw.test{http.request.orig_uri}
		}
		@member status 403
		handle_response @member {
			respond "Admins only. This site is for the people who run the server." 403
		}
	}
}
