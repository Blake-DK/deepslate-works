# Blocks in /home/ladm/docker/web-proxy/etc/Caddyfile on vps-01v (edit as ladm; reload recipe in deploy/README.md).

deepslate.dsw.test {
	import common
	# No request body above what the biggest server action takes (26 MB of poll pictures, next.config.ts); the routes
	# that read JSON hold their own, smaller limit (apps/web/src/server/read-json.ts).
	request_body {
		max_size 30MB
	}
	header X-Frame-Options SAMEORIGIN
	reverse_proxy deepslate-web:3000
}

# Live map (BlueMap on the AMP host, via the WireGuard tunnel relays). Login enforced by the portal.
map.deepslate.dsw.test {
	import common
	# Only the portal may show the map inside its own pages (Alex, 2026-09-29).
	header {
		Content-Security-Policy "frame-ancestors https://deepslate.dsw.test"
		defer
	}
	# forward_auth returns the 401 as-is, so spell it out: 2xx from /api/auth/verify -> map, 401 -> portal login.
	reverse_proxy deepslate-web:3000 {
		method GET
		rewrite /api/auth/verify
		header_up X-Forwarded-Method {method}
		header_up X-Forwarded-Uri {uri}
		@good status 2xx
		handle_response @good {
			reverse_proxy deepslate-map-relay-outer:8100
		}
		@unauth status 401
		handle_response @unauth {
			redir https://deepslate.dsw.test/login?next=https://map.deepslate.dsw.test{http.request.orig_uri}
		}
	}
}

# mc-router dashboard (on the AMP host, via the WireGuard tunnel relays). Admins only (Alex, 2026-10-07): it has no
# login of its own, it shows players' addresses and its POST/DELETE calls change live game routes.
router.deepslate.dsw.test {
	import common
	header {
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		X-Robots-Tag "noindex, nofollow"
	}
	# mc-router's webhook is for the AMP host's loopback; never passed on from here.
	@hook path /hook /hook/*
	respond @hook 404
	# Changes only from the dashboard's own page: a form on another site under the cookie's domain would carry the
	# login cookie too. Browsers send Origin on every POST and DELETE.
	@foreign {
		not method GET HEAD
		not header Origin https://router.deepslate.dsw.test
	}
	respond @foreign 403
	# As for the map, spelt out: 2xx from /api/auth/verify/admin -> dashboard, 401 -> portal login, 403 -> admins only.
	reverse_proxy deepslate-web:3000 {
		method GET
		rewrite /api/auth/verify/admin
		header_up X-Forwarded-Method {method}
		header_up X-Forwarded-Uri {uri}
		@good status 2xx
		handle_response @good {
			# The audit of route changes (Alex, 2026-10-07): every request in the access log carries the admin's user id.
			vars router_user {rp.header.X-User}
			log_append user {vars.router_user}
			# The portal's login cookie stays on the VPS.
			reverse_proxy deepslate-router-relay-outer:8090 {
				header_up -Cookie
			}
		}
		@unauth status 401
		handle_response @unauth {
			redir https://deepslate.dsw.test/login?next=https://router.deepslate.dsw.test{http.request.orig_uri}
		}
		@member status 403
		handle_response @member {
			respond "Admins only. This page is for the people who run the server." 403
		}
	}
}
