# The template for the .env of Dockhand's stack `deepslate` (deploy/home/README.md). Every variable the home stack reads,
# with a comment and a placeholder value. Placeholders: "replace-me-..." for secrets, all zeros for Discord and AMP ids,
# *.dsw.test for domains. Replace every one, or leave an optional one empty (the comment says which): nothing checks
# for a placeholder left in. The AMP host's LAN address below is the homelab's own; the live values are only in
# Dockhand's copy on docker-01v.

# The two roots, absolute. DEEPSLATE_DIR is this checkout (modpack/, .git, deploy/keys); DEEPSLATE_DATA holds postgres/,
# postgres-pre-upgrade/, backups/, data/, dist/, geoip/ and caddy/ (the stack's `init` makes them with the right owners).
# On docker-01v both live on /nvme (since 2026-10-28); /data is kept for media downloads.
DEEPSLATE_DIR=/nvme/stacks/deepslate
DEEPSLATE_DATA=/nvme/appdata/deepslate

# The owner (uid and gid) of the checkout: repo-sync runs git as them, so nothing in .git becomes another user's.
DEEPSLATE_UID=1000
DEEPSLATE_GID=1000
# Where the copies of .git/config and of the hooks' sha256 are kept, out of web's reach (deploy/README.md): repo-sync
# compares the checkout with git-config.expected and git-hooks.expected there before it pulls. Both files must exist,
# or docker makes empty folders in their place.
GIT_GUARD_DIR=/root/.config/deepslate

# GitHub owner (lower case) of the GHCR images ghcr.io/<owner>/deepslate-*. deepslate-web, -api and -installer are
# private packages: the host (and Dockhand, for its redeploy) needs a GHCR login with read:packages.
GHCR_OWNER=replace-me-github-owner
# The images a redeploy pulls for web, api, caddy, the designer and the one-shot steps: `latest` (main's newest), or one
# commit's sha to pin or roll back. The database and the dumps always follow `latest`: data a newer PostgreSQL has
# upgraded cannot go back.
IMAGE_TAG=latest
# The Windows app's image (deepslate-installer): `latest`, or a version such as 3.6.8.
INSTALLER_TAG=latest
# The optional services a redeploy runs, comma-separated: designer (with DESIGNER_CMD below), geoip (with
# GEOIPUPDATE_ACCOUNT_ID) and test (with TEST_STACK=1).
COMPOSE_PROFILES=

# Postgres password; DATABASE_URL is derived from it in docker-compose.yml.
POSTGRES_PASSWORD=replace-me-long-random-password

# Auth.js. AUTH_SECRET: openssl rand -base64 32 (a new one ends every session; see deploy/.env.example on TOTP_SEAL_KEY).
AUTH_SECRET=replace-me-openssl-rand-base64-32
TOTP_SEAL_KEY=
AUTH_URL=https://deepslate.dsw.test
# Parent-domain cookie so the map shares the login and nothing else on dsw.test sees it.
COOKIE_DOMAIN=.deepslate.dsw.test

# The host names Caddy serves (deploy/home/Caddyfile), each a Pangolin HTTP resource to deepslate-caddy:80 with
# Pangolin's own login off. The test site's name is read only while TEST_STACK=1.
SITE_HOST=deepslate.dsw.test
MAP_HOST=map.deepslate.dsw.test
TEST_HOST=test.deepslate.dsw.test
# The subnet of the external network ds-edge, the only place Caddy believes a forwarded address from (the newt).
# docker network inspect ds-edge shows it.
DS_EDGE_SUBNET=172.27.0.0/16

# The site's newt (the service `newt`, Pangolin's tunnel client): the id and secret Pangolin shows for the site
# "deepslate" (Sites → the site; a new pair invalidates the old one), and Pangolin's own https address, which the newt
# connects out to. All three required.
NEWT_ID=replace-me-newt-id
NEWT_SECRET=replace-me-newt-secret
PANGOLIN_ENDPOINT=https://pangolin.dsw.test

# Discord OAuth app (https://discord.com/developers/applications). Redirect URL: <AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=replace-me-discord-client-secret
# The first login from this Discord user id becomes ADMIN without an invite.
ADMIN_DISCORD_ID=000000000000000000
# Optional: only members of this Discord server may sign in with Discord.
DISCORD_GUILD_ID=000000000000000000
# 1 = being in that server counts as the invite. 0 = still need an invite.
DISCORD_GUILD_AUTO_JOIN=0
# Sign-in through Authentik (docs/04): the provider needs <AUTH_URL>/api/auth/callback/authentik (and the test site's).
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
DISCORD_DIRECT_LOGIN=
# The bot of the Discord app above (docs/22). Exactly one live api runs it (doc 62 §3.4).
DISCORD_BOT_TOKEN=replace-me-discord-bot-token
# Empty or 1: this api talks to the players' Discord (the bot and the webhooks). 0: the dry run of doc 62 §5.4 while
# the VPS's api is still the one that talks: the token only answers the sign-in question (whether an account is in
# the Discord server; sign-in through Authentik needs that answer), no bot comes online, no webhooks are used.
DISCORD_TALKS=
DISCORD_WEBHOOK_FEED=https://discord.com/api/webhooks/000000000000000000/replace-me
DISCORD_WEBHOOK_ADMIN=https://discord.com/api/webhooks/000000000000000000/replace-me
DISCORD_WEBHOOK_UPDATES=https://discord.com/api/webhooks/000000000000000000/replace-me
DISCORD_PLAYER_ROLE_ID=

# web -> api on ds-internal: api is deepslate-api:4000 here (no tunnel namespace); token: openssl rand -hex 32
API_URL=http://deepslate-api:4000
API_SERVICE_TOKEN=replace-me-openssl-rand-hex-32

# AMP on the LAN, reached by `api` over ds-amp (doc 62 §2): the ADS on 8080, the instance by id through its proxy path.
# AMP_HOST is the host's address for the sshd reachability check (/health "tunnel") and the map relay's target.
AMP_HOST=10.0.10.8
AMP_URL=http://10.0.10.8:8080
AMP_INSTANCE_ID=00000000-0000-0000-0000-000000000000
AMP_USERNAME=webapp
AMP_PASSWORD=replace-me-amp-password
# The rrsync key's user@host: (deploy/keys/deploy.key; the key's from= on the AMP host names this host)
RSYNC_TARGET=amp@10.0.10.8:
# The mc-router dashboard on the AMP host (Admin → Server → Router). Read by api only; the AMP host admits this host alone.
ROUTER_DASH_URL=http://10.0.10.8:8090
# 1 = run without a real AMP.
AMP_MOCK=1

# The address players join by, routed by mc-router on the homelab (docs/17).
SERVER_ADDRESS=mc.dsw.test
# BlueMap, behind the portal's login (the map's Pangolin resource).
MAP_URL=https://map.deepslate.dsw.test

# Modrinth requires a User-Agent that identifies the project.
MODRINTH_USER_AGENT=deepslate-works/0.1 (name@example.com)

# For admins' own tools only: openssl rand -hex 24
MANIFEST_KEY=replace-me-openssl-rand-hex-24

# docs/14: the sealed "white room" and the release point.
LIMBO_POS=deepslate:limbo 0.5 65 0.5
SPAWN_POS=0.5 105 0.5

# MaxMind GeoLite2-Country for the analytics page (the geoipupdate service, profile `geoip`). Both empty: the service
# is not started and api runs with no countries. A free MaxMind account gives the id and a licence key.
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=
# The file api reads, inside its container (the geoip folder is mounted there at /geoip).
GEOIP_DB=/geoip/GeoLite2-Country.mmdb

# docs/42: the test server's pair (web-test, api-test), profile `test`: a redeploy runs them while COMPOSE_PROFILES
# names `test`, and TEST_STACK=1 has db-prep make their database. TEST_DIR is the test checkout, on dev, owned by the deploy
# user (the stack's repo-sync-test brings it forward); TEST_AUTH_URL is
# https://<TEST_HOST>. Off, the TEST_ lines may keep their placeholders.
TEST_STACK=0
TEST_DIR=/nvme/stacks/deepslate-test
TEST_IMAGE_TAG=dev
TEST_AUTH_URL=https://test.deepslate.dsw.test
TEST_DISCORD_DIRECT_LOGIN=
TEST_AUTH_SECRET=replace-me-openssl-rand-base64-32
TEST_API_SERVICE_TOKEN=replace-me-openssl-rand-hex-32
TEST_SUMMARY_TOKEN=replace-me-openssl-rand-hex-32
TEST_APP_TOKEN=
TEST_AMP_INSTANCE_ID=00000000-0000-0000-0000-000000000000
TEST_AMP_USERNAME=webapp
TEST_AMP_PASSWORD=replace-me-amp-password
TEST_AMP_MOCK=
TEST_RSYNC_TARGET=amp@10.0.10.8:
TEST_SERVER_ADDRESS=lab.dsw.test
TEST_DISCORD_WEBHOOK_FEED=
TEST_DISCORD_WEBHOOK_ADMIN=
TEST_DISCORD_WEBHOOK_UPDATES=
TEST_SEASONS_SHIP=

# docs/39: the build designer (Admin → Seasons → Builds, "Design a build"), the service `designer`. Leave DESIGNER_CMD
# empty and `designer` out of COMPOSE_PROFILES to switch it off: the card then says "Not set up". With
# it set, DESIGNER_MODEL and DESIGNER_TOKEN (openssl rand -hex 32) are required, and every path is the designer's own
# host user's (uid 1010; docs/39 Step 1: the CLI installed and signed in once, as that user).
DESIGNER_CMD=
DESIGNER_MODEL=
DESIGNER_TOKEN=
DESIGNER_URL=http://deepslate-designer:4100
DESIGNER_UID=1010
DESIGNER_GID=1010
DESIGNER_HOME=/home/replace-me
DESIGNER_BIN_DIR=/home/replace-me/.local/bin
DESIGNER_VERSIONS_DIR=/home/replace-me/.local/share/replace-me
DESIGNER_CREDENTIALS=/home/replace-me/.replace-me/.credentials.json
# designer calls a day, all admins together (and at most 30 an hour); they count against the plan Alex's sessions use
DESIGNER_DAILY=80
