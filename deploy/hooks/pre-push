#!/bin/sh
# The pre-push hook of a checkout that pushes to the public repository. Installed by hand as .git/hooks/pre-push
# (deploy/README.md, "The pre-push hook"); its sha256 is listed with the other hooks in git-hooks.expected.
#
# 1. The local checks. A checkout may keep checks of its own that are not tracked, as .git/hooks/pre-push-local,
#    written like any pre-push hook. They run first, with the same arguments and the same lines on stdin. A checkout
#    that should have them and has lost the file is refused: PRE_PUSH_NO_LOCAL=1 says there are none.
#
# 2. Addresses. The repository is public, so it holds placeholder addresses only. A push is refused when a commit it
#    sends ADDS a line with an IPv4 address outside
#        203.0.113.0/24   198.51.100.0/24   127.0.0.0/8   0.0.0.0
#    Only what the push sends is read: the lines added by the commits the remote does not have yet. What is already
#    public is not read again, and a line that takes an address out passes.
#    Not an address: four numbers that are part of a longer version ("1.21.1-10.7.19.85", "21.0.12.1+1-LTS",
#    "0.12.15.5-beta.1", "1.2.3.4.5"), anything with a part over 255, and every line of a generated lock file
#    (pnpm-lock.yaml, *.lock.json). A bare version of four small numbers (Mekanism's, in a sentence or a table) reads
#    exactly like an address and is refused with the rest: look at the list, then push again with PUSH_ADDRESSES_OK=1.
#
# Git passes "<remote name> <remote url>" as arguments and "<local ref> <local sha> <remote ref> <remote sha>" per
# pushed ref on stdin. Plain sh, git and awk (busybox too), so the tests run this file as it is.

remote="$1"
zero=0000000000000000000000000000000000000000
here=$(dirname "$0")
input=$(cat)
refused=0

# 1. the local checks
lines() { [ -z "$input" ] || printf '%s\n' "$input"; }
if [ -f "$here/pre-push-local" ]; then
  lines | sh "$here/pre-push-local" "$@" || refused=1
elif [ "${PRE_PUSH_NO_LOCAL:-}" != "1" ]; then
  echo "pre-push: refused: $here/pre-push-local is missing, so this checkout's own checks did not run (PRE_PUSH_NO_LOCAL=1 if it has none)" >&2
  refused=1
fi

# 2. addresses
# The commits this push sends: everything the pushed commit reaches that no branch of the remote has yet.
if git remote 2>/dev/null | grep -qx -- "$remote"; then known="--remotes=$remote"; else known="--remotes"; fi

found=$(lines | while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  [ "$local_sha" = "$zero" ] && continue   # a deletion sends no commits
  not="$known"
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then not="$not $remote_sha"; fi
  # shellcheck disable=SC2086
  git -c log.showSignature=false log --no-color --no-ext-diff --no-textconv --format='commit %h' -p -U0 --diff-merges=first-parent "$local_sha" --not $not 2>/dev/null
done | awk '
  function allowed(a,    o) {
    split(a, o, ".")
    if (o[1] + 0 == 127) return 1
    if (o[1] + 0 == 203 && o[2] + 0 == 0 && o[3] + 0 == 113) return 1
    if (o[1] + 0 == 198 && o[2] + 0 == 51 && o[3] + 0 == 100) return 1
    if (o[1] + 0 == 0 && o[2] + 0 == 0 && o[3] + 0 == 0 && o[4] + 0 == 0) return 1
    return 0
  }
  function address(a,    o, i) {
    if (split(a, o, ".") != 4) return 0
    for (i = 1; i <= 4; i++) if (length(o[i]) > 3 || o[i] + 0 > 255) return 0
    return 1
  }
  # What git writes itself starts a commit ("commit"), a file ("diff --git") or a hunk ("@@"). Every line of content
  # comes with a "+" or "-" in front, so none of it can be taken for one of those. (No apostrophe in this program.)
  /^commit / { commit = $2; next }
  /^diff --git / { head = 1; file = "?"; skip = 0; next }
  /^@@ / { head = 0; next }
  head && /^\+\+\+ / { file = substr($0, 5); sub(/^b\//, "", file); skip = (file ~ /(^|\/)pnpm-lock\.yaml$/ || file ~ /\.lock\.json$/); next }
  !head && /^\+/ {
    if (skip) next
    rest = substr($0, 2); before = ""
    while (match(rest, /[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/)) {
      a = substr(rest, RSTART, RLENGTH)
      if (RSTART > 1) before = substr(rest, RSTART - 1, 1)
      after = substr(rest, RSTART + RLENGTH, 1)
      after2 = substr(rest, RSTART + RLENGTH + 1, 1)
      part = 0
      if (before ~ /[0-9A-Za-z._+-]/) part = 1                      # ...-10.7.19.85, v1.2.3.4
      if (after ~ /[0-9A-Za-z_+]/) part = 1                         # 21.0.12.1+1-LTS
      if (after == "." && after2 ~ /[0-9]/) part = 1                # 1.2.3.4.5
      if (after == "-" && after2 ~ /[A-Za-z]/) part = 1             # 0.12.15.5-beta.1
      if (!part && address(a) && !allowed(a)) print commit " " file ": " a
      before = substr(rest, RSTART + RLENGTH - 1, 1)
      rest = substr(rest, RSTART + RLENGTH)
    }
  }
' | sort -u)

if [ -n "$found" ]; then
  if [ "${PUSH_ADDRESSES_OK:-}" = "1" ]; then
    echo "pre-push: PUSH_ADDRESSES_OK=1, so these were let through:" >&2
    printf '%s\n' "$found" | sed 's/^/  /' >&2
  else
    echo "pre-push: refused: this push adds addresses outside the placeholder ranges (commit, file, address):" >&2
    printf '%s\n' "$found" | sed 's/^/  /' >&2
    echo "pre-push: use 203.0.113.x, 198.51.100.x or 127.0.0.1 and rewrite the commit. If every line above is a version number, push again with PUSH_ADDRESSES_OK=1." >&2
    refused=1
  fi
fi

if [ "$refused" -ne 0 ]; then
  echo "pre-push: push refused, nothing was sent" >&2
  exit 1
fi
exit 0
