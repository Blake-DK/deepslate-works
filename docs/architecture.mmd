flowchart TB
    player(["Player's Windows PC<br/>browser + DeepslateWorks.exe"])
    discord(["Discord<br/>sign-in, bot, announcements"])
    modrinth(["Modrinth<br/>mod files and versions"])

    subgraph github["GitHub"]
        repo["Repo<br/>modpack/mods.json is the one mod list"]
        ci["GitHub Actions<br/>tests, builds images and the installer"]
        ghcr["GHCR<br/>deepslate-web, deepslate-api, deepslate-installer"]
        repo --> ci --> ghcr
    end

    pangolin(["Pangolin<br/>TLS, publishes the site"])

    subgraph stack["docker-01v at home: stack deepslate in Dockhand (Docker Compose, never builds)"]
        newt["deepslate-newt<br/>Pangolin's tunnel client"]
        caddy["deepslate-caddy :80<br/>forward-auth for the map"]
        web["deepslate-web<br/>Next.js + Auth.js<br/>pages, votes, downloads"]
        db[("deepslate-db<br/>PostgreSQL 18 + Prisma")]
        backups["deepslate-backups<br/>nightly pg_dump"]
        relay["deepslate-map-relay"]
        api["deepslate-api<br/>Fastify: AMP client, action registry,<br/>console parser, status poller,<br/>modpack build and sync, Discord bot"]

        newt --> caddy
        caddy -->|deepslate.dsw.test| web
        caddy -->|map.deepslate.dsw.test| relay
        caddy -.->|is this person signed in?| web
        web -->|"api-client.ts, bearer token"| api
        web --> db
        api --> db
        backups --> db
    end

    subgraph homelab["Alex's homelab: the AMP host"]
        router["mc-router :25565<br/>routes by hostname"]
        ads["AMP ADS :8080<br/>HTTP API"]
        mc["Minecraft 1.21.1 NeoForge<br/>instance DeepslateWorks01"]
        bluemap["BlueMap :8100<br/>live map"]
        sshd["sshd<br/>rrsync, deploy key only"]
        ads --> mc
        router --> mc
        mc --- bluemap
        sshd --> mc
    end

    player -->|HTTPS| pangolin
    pangolin --> newt
    player -->|"game traffic, mc.dsw.test"| router
    web <-->|OAuth| discord
    api <-->|bot and webhooks| discord
    api -->|"lock: resolve versions"| modrinth
    player -->|"installer downloads mods"| modrinth

    api ==>|"LAN: status, console, start/stop"| ads
    api ==>|"LAN: rsync server files"| sshd
    relay ==>|LAN| bluemap

    ghcr -.->|"Dockhand pulls images, Redeploy"| stack
    repo -.->|"mods.json → mods.lock.json → dist/"| api
